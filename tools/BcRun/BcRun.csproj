<Project Sdk="Microsoft.NET.Sdk">
  <!-- BcRun: runs a PE32 EXE through the binary compiler as a guest process. Not part of BlitzCS.slnx. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>BcRun</AssemblyName>
    <RootNamespace>BlitzCS.BcRun</RootNamespace>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/BlitzCS.BinaryCompiler/BlitzCS.BinaryCompiler.csproj" />
    <ProjectReference Include="../../src/BlitzCS.BinaryCompiler.Runtime/BlitzCS.BinaryCompiler.Runtime.csproj" />
    <ProjectReference Include="../../src/BlitzCS.BinaryCompiler.Win32/BlitzCS.BinaryCompiler.Win32.csproj" />
  </ItemGroup>
</Project>
